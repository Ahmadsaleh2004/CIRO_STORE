{
  "name": "cairo-store-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "أدوات بناء وفحص الواجهة — Cairo Store",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build/build-css.mjs",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint public/js",
    "lint:css": "stylelint \"public/css/**/*.css\"",
    "lint:fix": "eslint public/js --fix && stylelint \"public/css/**/*.css\" --fix",
    "format": "prettier --write \"public/js/**/*.js\" \"public/css/**/*.css\"",
    "format:check": "prettier --check \"public/js/**/*.js\" \"public/css/**/*.css\""
  },
  "devDependencies": {
    "eslint": "^9.16.0",
    "globals": "^15.13.0",
    "lightningcss": "^1.28.2",
    "prettier": "^3.4.2",
    "stylelint": "^16.11.0",
    "stylelint-config-standard": "^36.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
