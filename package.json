{
  "name": "cairo-store-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "Front-end build and lint tooling — Cairo Store",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "node build/build-css.mjs",
    "build:js": "node build/build-js.mjs",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint public/js",
    "lint:css": "stylelint \"public/css/**/*.css\"",
    "lint:fix": "eslint public/js --fix && stylelint \"public/css/**/*.css\" --fix",
    "format": "prettier --write \"public/js/**/*.js\" \"public/css/**/*.css\"",
    "format:check": "prettier --check \"public/js/**/*.js\" \"public/css/**/*.css\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^9.16.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.28.2",
    "prettier": "^3.4.2",
    "stylelint": "^16.11.0",
    "stylelint-config-standard": "^36.0.1",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
