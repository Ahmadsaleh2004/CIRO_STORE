{
    "name": "store/app",
    "description": "PHP E-Commerce Store MVC Application",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/config/openapi_info.php"
        ],
        "exclude-from-classmap": [
            "app/config/",
            "app/helpers/",
            "app/views/"
        ]
    },
    "scripts": {
        "docs:generate": "vendor/bin/openapi app/Controllers app/config -o public/docs/openapi.yaml"
    },
    "require": {
        "phpmailer/phpmailer": "^7.1"
    }
}
