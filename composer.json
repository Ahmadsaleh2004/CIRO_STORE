{
    "name": "store/app",
    "description": "PHP E-Commerce Store MVC Application",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/config/openapi_info.php",
            "app/helpers/functions.php",
            "app/helpers/assets_helper.php",
            "app/helpers/auth_helper.php",
            "app/helpers/csrf_helper.php",
            "app/helpers/product_tag_helper.php",
            "app/helpers/product_variant_helper.php",
            "app/helpers/stock_badge_helper.php"
        ],
        "exclude-from-classmap": [
            "app/config/",
            "app/helpers/",
            "app/views/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "docs:generate": "vendor/bin/openapi app/Controllers app/config -o public/docs/openapi.yaml --format yaml",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "test:coverage": "phpunit --coverage-text --coverage-html coverage",
        "test:schema": "php -r \"require 'app/config/config.php'; passthru('mysqldump --no-data --skip-comments --skip-add-locks --skip-set-charset --routines=false --triggers=false -h ' . DB_HOST . ' -u ' . DB_USER . ' ' . DB_NAME . ' > tests/fixtures/schema.sql');\"",
        "analyse": "phpstan analyse --no-progress",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "check": [
            "@composer validate --strict",
            "@analyse",
            "@lint",
            "@test"
        ]
    },
    "require": {
        "phpmailer/phpmailer": "^7.1"
    },
    "require-dev": {
        "zircote/swagger-php": "^6.7",
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
