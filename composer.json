{
    "name": "store/app",
    "description": "PHP E-Commerce Store MVC Application",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/config/openapi_info.php",
            "app/helpers/functions.php",
            "app/helpers/assets_helper.php",
            "app/helpers/auth_helper.php",
            "app/helpers/csrf_helper.php",
            "app/helpers/product_tag_helper.php",
            "app/helpers/product_variant_helper.php",
            "app/helpers/stock_badge_helper.php"
        ],
        "exclude-from-classmap": [
            "app/config/",
            "app/helpers/",
            "app/views/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "docs:generate": "vendor/bin/openapi app/Controllers app/config -o public/docs/openapi.yaml --format yaml",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "test:coverage": "phpunit --coverage-text --coverage-html coverage",
        "test:schema": "php scripts/dump-schema.php",
        "migrate": "php scripts/migrate.php up",
        "migrate:status": "php scripts/migrate.php status",
        "migrate:baseline": "php scripts/migrate.php baseline",
        "analyse": "phpstan analyse --no-progress",
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "check": [
            "@composer validate --strict",
            "@analyse",
            "@lint",
            "@test"
        ]
    },
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "phpmailer/phpmailer": "^7.1"
    },
    "require-dev": {
        "zircote/swagger-php": "^6.7",
        "phpunit/phpunit": "^11",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0"
    }
}
