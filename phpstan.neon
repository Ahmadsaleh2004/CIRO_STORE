parameters:
    # المستوى 5 نقطة بداية مقيسة لا اعتباطية: أدنى منه لا يمسك شيئاً
    # ذا قيمة في مشروع بهذا الحجم، وأعلى منه ينتج خطّ أساس ضخماً يُخفي
    # الأخطاء الجديدة بين آلاف القديمة.
    #
    # ── المستوى 6: مرفوع ونظيف ────────────────────────────────
    #
    # كان القياس قبل الرفع **156 خطأً — وصفر منها خطأ منطقي**:
    #
    #     missingType.iterableValue   152
    #     missingType.parameter         3
    #     missingType.return            1
    #
    # أي أن الرفع كان عملاً توثيقياً لا صيدَ أعطال — وهو خبر جيّد عن
    # المستوى 5: لم يكن يختبئ تحته منطق مكسور.
    #
    # وأُنجز **بلا baseline**. تمريره بها كان ينهي البند في دقيقة
    # ويناقض السطر الثاني أعلاه مناقضةً مباشرة: يُنتج بالضبط خطّ الأساس
    # الضخم الذي يُخفي الأخطاء الجديدة بين القديمة.
    #
    # ── وأثبت المستوى قيمته أثناء الرفع نفسه ──────────────────
    #
    # أمسك ستّة تعليقات **خاطئة** كُتبت أثناء العمل:
    #
    #   · AdminModel::createAdmin — `$perms` خريطة «اسم ← منح» لا قائمة
    #     أسماء، بخلاف findByPermsAndRanks التي تستقبل قائمة. الاسم
    #     واحد والشكل مختلف، وهو فرق لا يظهر في توقيع `array` المجرّد.
    #   · ProductModel::findStockByIds — تُرجع خريطة مفهرسة بالمعرّف لا
    #     قائمة.
    #   · AdminController::sendCsv — أضيق ممّا يمرّره مستدعيه فعلاً.
    #   · وثلاثة عوائد في scripts/ ظُنّت قوائم وهي أشكال مسمّاة.
    #
    # وهذا هو الخطر الحقيقي في هذا المستوى، لا الكسر: **تعليق نوع خاطئ
    # أسوأ من غيابه** — يبني عليه المحلّل فيسكت عن أخطاء حقيقية، ولا
    # يمسكه اختبار ولا هو نفسه. القاعدة المتبعة: لا يُكتب نوع لا يُرى
    # في الكود، وعند الشكّ `array<string, mixed>` لا تخمينٌ أضيق.
    #
    # المستوى 7 هو التالي، ويحتاج قياساً مستقلاً قبل أي وعد.
    level: 6

    paths:
        - app
        - scripts
        - tests

    # الـviews قوالب إخراج تعتمد على متغيّرات يحقنها Controller::view()
    # عبر extract() — لا يستطيع أي محلّل ثابت تتبّعها، فكل سطر فيها
    # سيصير إنذاراً كاذباً.
    excludePaths:
        - app/views/*

    # الثوابت التي يعرّفها config.php وقت التشغيل. بلا إعلانها هنا يرى
    # المحلّل كل استعمال لها خطأً — وهي مستعملة في 63 ملفاً.
    bootstrapFiles:
        - tests/phpstan-bootstrap.php

    # دوال الهيلبرز تُحمَّل عبر composer autoload.files، فالمحلّل يراها.
    scanFiles:
        - app/helpers/functions.php
        - app/helpers/assets_helper.php
        - app/helpers/auth_helper.php
        - app/helpers/csrf_helper.php
        - app/helpers/product_tag_helper.php
        - app/helpers/product_variant_helper.php
        - app/helpers/stock_badge_helper.php
        - app/config/env_loader.php

    treatPhpDocTypesAsCertain: false
