parameters:
    # Level 5 was a measured starting point rather than an arbitrary one: below it nothing
    # of value is caught in a project this size, and above it a huge baseline is produced
    # that hides the new errors among thousands of old ones.
    #
    # ── Level 6: raised, and clean ────────────────────────────
    #
    # The measurement before raising it was **156 errors — and none of them a logic error**:
    #
    #     missingType.iterableValue   152
    #     missingType.parameter         3
    #     missingType.return            1
    #
    # That is, raising it was documentation work rather than a hunt for faults — which is
    # good news about level 5: no broken logic had been hiding under it.
    #
    # And it was done **without a baseline**. Passing one would have closed the item in a
    # minute while contradicting the second line above outright: it produces exactly the huge
    # baseline that hides new errors among the old.
    #
    # ── And the level proved its worth during the raise itself ─
    #
    # It caught six **wrong** annotations written along the way:
    #
    #   · AdminModel::createAdmin — `$perms` is a map of "name → grant", not a list of
    #     names, unlike findByPermsAndRanks which takes a list. The name is the same and the
    #     shape is different, a difference invisible in a bare `array` signature.
    #   · ProductModel::findStockByIds — returns a map keyed by id, not a list.
    #   · AdminController::sendCsv — narrower than what its caller actually passes.
    #   · and three returns in scripts/ thought to be lists while they are named shapes.
    #
    # And that is the real danger at this level, not breakage: **a wrong type annotation is
    # worse than none** — the analyser builds on it and falls silent about real errors, and
    # neither a test nor the analyser itself catches it. The rule followed: no type is
    # written that cannot be seen in the code, and when in doubt `array<string, mixed>`
    # rather than a narrower guess.
    #
    # Level 7 is next, and it needs a measurement of its own before any promise.
    level: 6

    paths:
        - app
        - scripts
        - tests

    # The views are output templates relying on variables injected by Controller::view()
    # through extract() — no static analyser can trace those, so every line in them would
    # become a false alarm.
    excludePaths:
        - app/views/*

    # The constants config.php defines at run time. Without declaring them here the
    # analyser sees every use of them as an error — and they are used across 63 files.
    bootstrapFiles:
        - tests/phpstan-bootstrap.php

    # The helper functions are loaded through composer autoload.files, so the analyser sees
    # them.
    scanFiles:
        - app/helpers/functions.php
        - app/helpers/assets_helper.php
        - app/helpers/auth_helper.php
        - app/helpers/csrf_helper.php
        - app/helpers/product_tag_helper.php
        - app/helpers/product_variant_helper.php
        - app/helpers/stock_badge_helper.php
        - app/config/env_loader.php

    treatPhpDocTypesAsCertain: false
