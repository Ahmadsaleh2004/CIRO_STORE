# ══════════════════════════════════════════════════════════════
# Editor settings — Cairo Store
# ══════════════════════════════════════════════════════════════
#
# It complements .gitattributes rather than contradicting it: that governs what is stored
# in git, and this governs what the editor writes before it gets there.
#
# end_of_line = lf is deliberate and consistent with `* text=auto`: git always stores LF,
# and checks CRLF out on Windows alone. Writing LF means no file ever carries mixed endings.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# PSR-12 requires four spaces — see phpcs.xml
[*.php]
indent_size = 4

[*.{js,css,html}]
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
# Trailing spaces in Markdown mean a deliberate line break.
trim_trailing_whitespace = false

[*.{sql,sh}]
indent_size = 4

[Makefile]
indent_style = tab
