# ── Secrets ────────────────────────────────────────────
# .env holds the database password, the Google OAuth and hCaptcha keys and the SMTP
# password. It is never committed. The shareable copy is .env.example
.env

# ── Generated dependencies ─────────────────────────────
# composer.lock is tracked, so `composer install` rebuilds the directory exactly
/vendor/

# Note: /public/docs/ is tracked deliberately despite being generated — openapi.yaml and
# index.html are actually served by the server (Swagger UI), and losing them on any restore
# means losing the API documentation until it is regenerated.

# ── Run-time data ──────────────────────────────────────
# The directory and its .htaccess are kept, not the backups themselves
/storage/backups/*
!/storage/backups/.htaccess


# ── Miscellaneous ──────────────────────────────────────
*.log
Thumbs.db
desktop.ini
.DS_Store

# Note: /public/images/ is tracked deliberately — the database points at these files by
# path, and losing them breaks the store on any restore. Revisit this if the uploaded
# images grow much larger.

# ── graphify output ──────────────────────────────────
# The knowledge graph is generated entirely from the code and the documentation, and is
# rebuilt with /graphify. It is around 2MB and there is no value in tracking its versions.
/graphify-out/

# ── Local developer tool settings ────────────────────
# They belong to the machine rather than the project, and sharing them is meaningless.
/.claude/

# ── Internal documentation ────────────────────────────
# The decision log is archived outside the repository and is not committed with the code.
/docs/

# ── Test output ───────────────────────────────────────
# PHPUnit's cache and the coverage reports — generated, and not tracked.
/.phpunit.cache/
/coverage/
.phpunit.result.cache

# ── The local CIRO_STORE copy ─────────────────────────
# The STORE/ directory inside the project is an independent git repository pointing at
# github.com/Ahmadsaleh2004/CIRO_STORE — a copy taken by hand for publishing.
# Excluding it prevents committing it by accident as an embedded repository (50 MB).
/STORE/

# And the STORE.zip archive beside it — a copy kept deliberately, 75 MB in size.
# It was untracked by chance rather than by rule: the first `git add .` would have swallowed
# it and bloated the repository irreversibly. The file stays where it is, and this rule
# stops it being committed.
/STORE.zip

# ── Front-end dependencies ────────────────────────────────
# Installed with `npm ci` from package-lock.json.
/node_modules/

# Note: public/css/dist/ is **tracked deliberately**. Deploying here means copying files
# rather than a build step on the server, so the built bundles have to arrive with it. And a
# step in CI rebuilds them and compares the fingerprint, so a dist lagging behind its source
# never passes.


# ── Lighthouse output ─────────────────────────────────
/.lighthouseci/
