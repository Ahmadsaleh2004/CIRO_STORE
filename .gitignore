# ── أسرار ──────────────────────────────────────────────
# .env فيه كلمة مرور قاعدة البيانات ومفاتيح Google OAuth و hCaptcha
# وكلمة مرور SMTP. لا يُرفع أبداً. النسخة القابلة للمشاركة هي .env.example
.env

# ── تبعيات مُولَّدة ──────────────────────────────────────
# composer.lock مُتتبَّع، فـ`composer install` يعيد بناء المجلد بالضبط
/vendor/

# ملاحظة: /public/docs/ متتبَّع عن قصد رغم كونه مُولَّداً — الملفان
# openapi.yaml و index.html مخدومان فعلاً من الخادم (Swagger UI)،
# وفقدانهما عند أي استرجاع يعني ضياع توثيق الـAPI حتى يُعاد التوليد.

# ── بيانات وقت التشغيل ─────────────────────────────────
# نُبقي المجلد و .htaccess فقط، لا النسخ الاحتياطية نفسها
/storage/backups/*
!/storage/backups/.htaccess


# ── متفرقات ────────────────────────────────────────────
*.log
Thumbs.db
desktop.ini
.DS_Store

# ملاحظة: /public/images/ متتبَّع عن قصد — قاعدة البيانات تشير لهذه
# الملفات بالمسار، وفقدانها يكسر المتجر عند أي استرجاع. أعِد النظر
# في ذلك لو كبر حجم الصور المرفوعة كثيراً.

# ── مخرجات graphify ──────────────────────────────────
# رسم المعرفة مُولَّد بالكامل من الكود والوثائق، ويُعاد بناؤه
# بـ/graphify. حجمه ~2MB ولا قيمة لتتبّع نسخه.
/graphify-out/

# ── إعدادات محلية لأدوات المطوّر ──────────────────────
# خاصة بالجهاز لا بالمشروع، ولا معنى لمشاركتها.
/.claude/

# ── توثيق داخلي ───────────────────────────────────────
# سجلّ القرارات مؤرشف خارج المستودع، لا يُرفع مع الكود.
/docs/

# ── مخرجات الاختبارات ─────────────────────────────────
# ذاكرة PHPUnit المؤقتة وتقارير التغطية — تُولَّد ولا تُتتبَّع.
/.phpunit.cache/
/coverage/
.phpunit.result.cache

# ── نسخة CIRO_STORE المحلية ───────────────────────────
# مجلد STORE/ داخل المشروع مستودع git مستقل يشير إلى
# github.com/Ahmadsaleh2004/CIRO_STORE — نسخة أُخذت يدوياً للرفع.
# استثناؤه يمنع التزامه بالخطأ كمستودع مضمّن (50 ميغابايت).
/STORE/

# وأرشيف STORE.zip بجانبه — نسخة محفوظة عمداً، حجمها ٧٥ ميغابايت.
# كان غير متتبَّع بالصدفة لا بقاعدة: أوّل `git add .` كان سيبتلعه
# ويضخّم المستودع بلا رجعة. الملف يبقى مكانه، والقاعدة تمنع التزامه.
/STORE.zip

# ── اعتماديات الواجهة ─────────────────────────────────────
# تُثبَّت بـ`npm ci` من package-lock.json.
/node_modules/

# ملاحظة: public/css/dist/ **متتبَّع عن قصد**. النشر هنا نسخ ملفات لا
# خطوة بناء على الخادم، فالحزم المبنيّة يجب أن تصل معه. وخطوة في CI
# تعيد البناء وتقارن البصمة، فلا يمرّ dist متخلّف عن مصدره.


# ── مخرجات Lighthouse ─────────────────────────────────
/.lighthouseci/
