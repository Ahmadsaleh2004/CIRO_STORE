# ── أسرار ──────────────────────────────────────────────
# .env فيه كلمة مرور قاعدة البيانات ومفاتيح Google OAuth و hCaptcha
# وكلمة مرور SMTP. لا يُرفع أبداً. النسخة القابلة للمشاركة هي .env.example
.env

# ── تبعيات مُولَّدة ──────────────────────────────────────
# composer.lock مُتتبَّع، فـ`composer install` يعيد بناء المجلد بالضبط
/vendor/

# ملاحظة: /public/docs/ متتبَّع عن قصد رغم كونه مُولَّداً — الملفان
# openapi.yaml و index.html مخدومان فعلاً من الخادم (Swagger UI)،
# وفقدانهما عند أي استرجاع يعني ضياع توثيق الـAPI حتى يُعاد التوليد.

# ── بيانات وقت التشغيل ─────────────────────────────────
# نُبقي المجلد و .htaccess فقط، لا النسخ الاحتياطية نفسها
/storage/backups/*
!/storage/backups/.htaccess


# ── متفرقات ────────────────────────────────────────────
*.log
Thumbs.db
desktop.ini
.DS_Store

# ملاحظة: /public/images/ متتبَّع عن قصد — قاعدة البيانات تشير لهذه
# الملفات بالمسار، وفقدانها يكسر المتجر عند أي استرجاع. أعِد النظر
# في ذلك لو كبر حجم الصور المرفوعة كثيراً.

# ── مخرجات graphify ──────────────────────────────────
# رسم المعرفة مُولَّد بالكامل من الكود والوثائق، ويُعاد بناؤه
# بـ/graphify. حجمه ~2MB ولا قيمة لتتبّع نسخه.
/graphify-out/
