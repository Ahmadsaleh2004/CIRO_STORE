# A shareable copy of .env — copy it to .env and fill in the values.
# The .env file itself is git-ignored because it holds real secrets.

# --- Application ---
# APP_ENV: local for development, production for a deployment.
# ⚠️ When the key is absent or left empty, production is assumed — that is, the errors are
# hidden rather than displayed. The safe default is deliberate: forgetting to set it should
# conceal rather than disclose.
APP_ENV=production
# APP_DEBUG: true displays the errors in the browser. Leave it false on any public server —
# PHP's messages carry the server's paths and the database names.
# Accepted values: 1 true yes on (and anything else means false).
APP_DEBUG=false
# APP_URL: the site's root, with no trailing slash.
APP_URL=
APP_NAME=Cairo Store

DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Google OAuth — add the real values from the Google Cloud Console
# https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# hCaptcha — Admin Login Protection
# Add the real values from https://dashboard.hcaptcha.com/
# The site key appears in the browser (public)
# The secret key is used server-side only (private and protected)
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
# --- Mail Settings (Gmail SMTP) ---
MAIL_HOST=
MAIL_PORT=
MAIL_ENCRYPTION=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
# --- Error Monitoring (Sentry) ---
# Leave it empty to disable monitoring entirely — the code checks for its presence before
# any initialisation, so a development environment runs with no Sentry account and no
# network request at all.
# The value comes from: Sentry → Settings → Projects → <the project> → Client Keys (DSN)
SENTRY_DSN=
# The performance trace sample rate (0.0 = off). Errors are always sent, regardless of this.
SENTRY_TRACES_SAMPLE_RATE=0.0
