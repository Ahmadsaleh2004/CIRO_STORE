# نسخة قابلة للمشاركة من .env — انسخها إلى .env واملأ القيم.
# الملف .env نفسه مستثنى من git لأنه يحوي أسراراً حقيقية.

DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Google OAuth — أضف القيم الحقيقية من Google Cloud Console
# https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# hCaptcha — Admin Login Protection
# أضف القيم الحقيقية من https://dashboard.hcaptcha.com/
# Site Key يظهر في الـ browser (public)
# Secret Key يُستخدم server-side فقط (خاص ومحمي)
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
# --- Mail Settings (Gmail SMTP) ---
MAIL_HOST=
MAIL_PORT=
MAIL_ENCRYPTION=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=