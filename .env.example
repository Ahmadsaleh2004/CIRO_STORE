# نسخة قابلة للمشاركة من .env — انسخها إلى .env واملأ القيم.
# الملف .env نفسه مستثنى من git لأنه يحوي أسراراً حقيقية.

# --- Application ---
# APP_ENV: local للتطوير، production للنشر.
# ⚠️ عند غياب المفتاح أو تركه فارغاً يُفترض production — أي تُخفى
# الأخطاء ولا تُعرض. الافتراضي الآمن مقصود: نسيان الضبط يجب أن يُخفي
# لا أن يكشف.
APP_ENV=production
# APP_DEBUG: true يعرض الأخطاء في المتصفح. اتركه false على أي خادم
# عام — رسائل PHP تحمل مسارات الخادم وأسماء القواعد.
# القيم المقبولة: 1 true yes on (وأي شيء آخر يعني false).
APP_DEBUG=false
# APP_URL: جذر الموقع بلا شرطة مائلة في آخره.
APP_URL=
APP_NAME=Cairo Store

DB_HOST=
DB_PORT=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Google OAuth — أضف القيم الحقيقية من Google Cloud Console
# https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# hCaptcha — Admin Login Protection
# أضف القيم الحقيقية من https://dashboard.hcaptcha.com/
# Site Key يظهر في الـ browser (public)
# Secret Key يُستخدم server-side فقط (خاص ومحمي)
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
# --- Mail Settings (Gmail SMTP) ---
MAIL_HOST=
MAIL_PORT=
MAIL_ENCRYPTION=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=
# --- Error Monitoring (Sentry) ---
# اتركه فارغاً لتعطيل الرصد تماماً — الكود يفحص وجوده قبل أي تهيئة،
# فبيئة التطوير تعمل بلا حساب Sentry وبلا أي طلب شبكة.
# القيمة من: Sentry → Settings → Projects → <المشروع> → Client Keys (DSN)
SENTRY_DSN=
# نسبة تتبّع الأداء (0.0 = مُطفأ). الأخطاء تُرسَل دائماً بلا علاقة بهذا.
SENTRY_TRACES_SAMPLE_RATE=0.0
