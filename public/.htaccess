# ══════════════════════════════════════════════════════════════
# جذر الويب — Cairo Store
# ══════════════════════════════════════════════════════════════

# ── توجيه كل ما ليس ملفاً أو مجلداً إلى الراوتر ──────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ── تخزين مؤقّت للأصول المبصومة ──────────────────────────────
#
# ملفات public/css/dist/ تحمل بصمة محتواها في أسمائها
# (store.f7069eb70046.css)، فتغيّر المحتوى يغيّر الرابط. ولذلك يصحّ
# تخزينها سنة كاملة بـimmutable: المتصفح لا يسأل عنها إطلاقاً، ولا
# خطر من قِدَمها لأن النسخة الجديدة تحمل اسماً آخر.
#
# ⚠️ محصورة في dist/ عمداً. تطبيقها على css/ أو js/ العاديين — وهي
# بلا بصمة — يعني أن تعديلاً لن يصل الزائر لسنة.
<IfModule mod_headers.c>
    <FilesMatch "\.[0-9a-f]{12}\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ── ترويسات أمنية ────────────────────────────────────────────
#
# لم تكن هنا أي ترويسة أمنية إطلاقاً (مفحوص: صفر موضع في المشروع كله).
# `always` مقصود: بدونه لا تُضاف الترويسة إلى استجابات الخطأ — وصفحة
# 404 أو 500 تحتاج الحماية كما تحتاجها الصفحة الناجحة.
<IfModule mod_headers.c>

    # المتصفح لا يخمّن نوع المحتوى. يقطع هجمات رفع ملف يُقدَّم كـHTML.
    Header always set X-Content-Type-Options "nosniff"

    # لا يُدرَج الموقع في إطار من نطاق آخر — حماية من clickjacking.
    # (frame-ancestors في CSP أدناه هو البديل الحديث؛ يبقى هذا
    #  للمتصفحات التي لا تقرأه.)
    Header always set X-Frame-Options "SAMEORIGIN"

    # لا يُسرَّب المسار الكامل للمواقع الخارجية — النطاق وحده، وفقط
    # عند البقاء على https.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # صلاحيات المتصفح التي لا يستعملها المتجر — تُغلق صراحةً.
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # HSTS مشروط بـHTTPS عمداً. إرساله على http بلا معنى، وإرساله من
    # بيئة تطوير محلية يثبّت المتصفح على https للـlocalhost كله —
    # فيكسر كل مشروع آخر على الجهاز نفسه ويصعب التراجع عنه.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # إخفاء نسخة PHP من الترويسات.
    Header always unset X-Powered-By

    # ── CSP: سياستان معاً ─────────────────────────────────────
    #
    # **مفروضة** لكل شيء عدا السكربتات، و**بوضع الإبلاغ** للهدف الكامل.
    # وهذا ليس تردّداً بل وصفٌ دقيق لما يمكن فرضه اليوم.
    #
    # ما صار مفروضاً فعلاً — وكلّه مكسب حقيقي فوري:
    #   object-src 'none'    يقطع <object> و<embed> — ناقلا هجوم قديمان
    #   base-uri 'self'      يمنع حقن <base> الذي يحوّل كل رابط نسبي
    #   form-action 'self'   يمنع تحويل وجهة أي نموذج إلى خادم آخر
    #   frame-ancestors      clickjacking
    #   img/connect/frame    حصر الوجهات
    #
    # ولماذا script-src فيها 'unsafe-inline'؟
    #
    # أُخرجت **أربع عشرة** كتلة <script> مضمّنة من الـviews إلى جزر
    # JSON (راجع pageData في assets_helper.php) — وهو ما كان يمنع أي
    # سياسة أصلاً. بقي عائقان:
    #
    #   1. اثنان وثلاثون معالجاً مضمّناً (onclick/onchange) في الوسوم.
    #   2. سكربت تهيئة الثيم في <head>، ويجب أن يعمل **قبل الرسم** وإلا
    #      ومض المستخدم بالثيم الخطأ.
    #
    # والثاني محلول ببصمته أدناه. أما الأول فيحتاج تحويل كل معالج إلى
    # addEventListener — عمل ميكانيكي لكن كل زرّ فيه يحتاج نقرة فعلية
    # للتحقّق، وشحنه بلا ذلك أسوأ من تركه.
    #
    # ⚠️ ولماذا لا تُخلط البصمة مع 'unsafe-inline' في سياسة واحدة؟
    # لأن المعيار (CSP3 §6.6.2.4) يقول إن وجود بصمة أو nonce **يُلغي**
    # 'unsafe-inline' تماماً. فالخلط يكسر المعالجات الاثنين والثلاثين
    # بدل أن يشدّد شيئاً. ولهذا سياستان: واحدة تفرض ما تستطيع، وأخرى
    # تُبلغ عن الهدف.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://code.jquery.com https://js.hcaptcha.com https://*.hcaptcha.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://*.hcaptcha.com; img-src 'self' data: https:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' https://*.hcaptcha.com; frame-src https://*.hcaptcha.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"

    # الهدف: بلا 'unsafe-inline' إطلاقاً، وسكربت الثيم مسموح ببصمته
    # وحدها. حين تُحوَّل المعالجات الاثنان والثلاثون، تحلّ هذه محلّ
    # التي فوقها بحذف اللاحقة -Report-Only.
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'sha256-n33GJ973YEUTpbG1xOj611JYTc5wI4V+8xmEtfPaLjk=' https://cdn.jsdelivr.net https://code.jquery.com https://js.hcaptcha.com https://*.hcaptcha.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://*.hcaptcha.com; img-src 'self' data: https:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' https://*.hcaptcha.com; frame-src https://*.hcaptcha.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"


</IfModule>
