# ══════════════════════════════════════════════════════════════
# جذر الويب — Cairo Store
# ══════════════════════════════════════════════════════════════

# ── توجيه كل ما ليس ملفاً أو مجلداً إلى الراوتر ──────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ── تخزين مؤقّت للأصول المبصومة ──────────────────────────────
#
# ملفات public/css/dist/ تحمل بصمة محتواها في أسمائها
# (store.f7069eb70046.css)، فتغيّر المحتوى يغيّر الرابط. ولذلك يصحّ
# تخزينها سنة كاملة بـimmutable: المتصفح لا يسأل عنها إطلاقاً، ولا
# خطر من قِدَمها لأن النسخة الجديدة تحمل اسماً آخر.
#
# ⚠️ محصورة في dist/ عمداً. تطبيقها على css/ أو js/ العاديين — وهي
# بلا بصمة — يعني أن تعديلاً لن يصل الزائر لسنة.
<IfModule mod_headers.c>
    <FilesMatch "\.[0-9a-f]{12}\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ── ترويسات أمنية ────────────────────────────────────────────
#
# لم تكن هنا أي ترويسة أمنية إطلاقاً (مفحوص: صفر موضع في المشروع كله).
# `always` مقصود: بدونه لا تُضاف الترويسة إلى استجابات الخطأ — وصفحة
# 404 أو 500 تحتاج الحماية كما تحتاجها الصفحة الناجحة.
<IfModule mod_headers.c>

    # المتصفح لا يخمّن نوع المحتوى. يقطع هجمات رفع ملف يُقدَّم كـHTML.
    Header always set X-Content-Type-Options "nosniff"

    # لا يُدرَج الموقع في إطار من نطاق آخر — حماية من clickjacking.
    # (frame-ancestors في CSP أدناه هو البديل الحديث؛ يبقى هذا
    #  للمتصفحات التي لا تقرأه.)
    Header always set X-Frame-Options "SAMEORIGIN"

    # لا يُسرَّب المسار الكامل للمواقع الخارجية — النطاق وحده، وفقط
    # عند البقاء على https.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # صلاحيات المتصفح التي لا يستعملها المتجر — تُغلق صراحةً.
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # HSTS مشروط بـHTTPS عمداً. إرساله على http بلا معنى، وإرساله من
    # بيئة تطوير محلية يثبّت المتصفح على https للـlocalhost كله —
    # فيكسر كل مشروع آخر على الجهاز نفسه ويصعب التراجع عنه.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # إخفاء نسخة PHP من الترويسات.
    Header always unset X-Powered-By

    # ── CSP: مفروضة بالكامل ───────────────────────────────────
    #
    # **بلا 'unsafe-inline' في script-src.** لم تكن هذه ممكنة قبل
    # اليوم: كانت الـviews تحوي أربع عشرة كتلة <script> مضمّنة وثلاثة
    # وثلاثين معالج onclick/onchange — وكلّها كتل تنفيذ تحجبها أي
    # سياسة جادّة.
    #
    # ما تغيّر ليصير هذا ممكناً:
    #   · البيانات → جزر <script type="application/json"> (pageData)
    #     وهي ليست كتل تنفيذ فلا يعنيها script-src أصلاً.
    #   · المعالجات → data-action وسمات data-*، يفوّضها مستمع واحد
    #     في js/core/inline-actions.js.
    #   · سكربت تهيئة الثيم → مسموح **ببصمته وحدها**. لا يمكن نقله إلى
    #     ملف: يجب أن يعمل قبل الرسم وإلا ومض المستخدم بالثيم الخطأ.
    #
    # ⚠️ البصمة مرتبطة بمحتوى themeBootScript() حرفاً بحرف. أي تعديل
    # عليه — ولو مسافة — يُبطلها فيتوقّف السكربت ويومض الثيم. أعد
    # حسابها عند أي تغيير:
    #     php -r "require 'app/config/config.php'; require 'vendor/autoload.php';
    #             preg_match('#<script>(.*?)</script>#s', themeBootScript(), \$m);
    #             echo 'sha256-'.base64_encode(hash('sha256', \$m[1], true));"
    #
    # img-src بلا `https:` المفتوحة.
    #
    # كانت مفتوحة لسبب واحد: صورة QR للمصادقة الثنائية كانت تُجلَب من
    # api.qrserver.com — برابط يحمل **السرّ نفسه** في الـquery string.
    # الصورة تُولَّد محلياً الآن (bacon/bacon-qr-code) وتُسلَّم كـdata:
    # URI، فلم يبقَ ما يبرّر السماح بأي مضيف صور على الإنترنت.
    #
    # مفحوص قبل التشديد: لا صورة خارجية في أي view، ولا في البيانات
    # (منتجات · variants · شرائح السلايدر — صفر مسار يبدأ بـhttp).
    # `data:` تبقى: هي ما تحمل الـQR الآن.
    #
    # style-src فيها 'unsafe-inline' بعد: 241 سمة style= في الـviews.
    # وهي الخطوة التالية، وأثرها الأمني أقلّ بكثير من السكربتات.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-n33GJ973YEUTpbG1xOj611JYTc5wI4V+8xmEtfPaLjk=' https://cdn.jsdelivr.net https://code.jquery.com https://js.hcaptcha.com https://*.hcaptcha.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://*.hcaptcha.com; img-src 'self' data:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' https://*.hcaptcha.com; frame-src https://*.hcaptcha.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"


</IfModule>
