# ══════════════════════════════════════════════════════════════
# The web root — Cairo Store
# ══════════════════════════════════════════════════════════════

# ── Route everything that is not a file or a directory to the router ──
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Browsers ask for /favicon.ico on their own. There was none, so the request fell through
    # to the router and the whole application ran to answer it with a 404 — 0.4 s of PHP on
    # most visits. The pages name favicon.svg; this serves the same file to the ones that ask
    # by the old name.
    RewriteRule ^favicon\.ico$ favicon.svg [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ── Caching for the fingerprinted assets ─────────────────────
#
# The files in public/css/dist/ carry their content's fingerprint in their names
# (store.f7069eb70046.css), so a change in content changes the URL. Which is why caching
# them for a full year as immutable is correct: the browser never asks about them again, and
# their age is no danger because the new version carries a different name.
#
# ⚠️ Confined to dist/ deliberately. Applying it to the ordinary css/ or js/ — which carry
# no fingerprint — would mean an edit never reaching a visitor for a year.
<IfModule mod_headers.c>
    <FilesMatch "\.[0-9a-f]{12}\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Images: a month. Uploaded product and slider images get a new, unique file name
    # (product_<time>_<random>.jpg), so a replaced image is a new URL and never a stale one.
    # Without a Cache-Control the browser asked about every image on every visit — or, worse,
    # kept it for however long its own heuristic decided.
    <FilesMatch "\.(?:jpe?g|png|gif|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # The same year-long rule for the files assetStamp() fingerprints in the query string —
    # a page's own stylesheet (pageCss), a page script (jsTag), the icon sprite:
    # `?v=<10 hex>` is the first ten characters of the file's sha256, so a change in content
    # is a change in URL, exactly as with the names in dist/. Checked against the query
    # string alone: the same file requested without ?v= keeps the ordinary rules.
    # <If> is merged after <FilesMatch>, so this wins over the month given to images above.
    <If "%{QUERY_STRING} =~ /^v=[0-9a-f]{10}$/">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>

    # A compressed response gets its ETag suffixed with "-gzip" by mod_deflate, and the
    # browser sends that suffixed value back in If-None-Match — which then never matches the
    # file's own ETag, so the server answered 200 with the whole file every time instead of
    # a 304. Stripping the suffix from the request lets the comparison succeed.
    RequestHeader edit "If-None-Match" "^\"(.*)-gzip\"$" "\"$1\""
</IfModule>

# ── Security headers ─────────────────────────────────────────
#
# There was no security header here at all (verified: zero sites in the whole project).
# `always` is deliberate: without it the header is not added to error responses — and a 404
# or 500 page needs the protection just as a successful page does.
<IfModule mod_headers.c>

    # The browser does not guess the content type. It cuts off attacks that upload a file
    # served as HTML.
    Header always set X-Content-Type-Options "nosniff"

    # The site is not embedded in a frame from another origin — clickjacking protection.
    # (frame-ancestors in the CSP below is the modern replacement; this stays for browsers
    #  that do not read it.)
    Header always set X-Frame-Options "SAMEORIGIN"

    # The full path is not leaked to external sites — the origin alone, and only while
    # staying on https.
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # The browser capabilities the store does not use — closed explicitly.
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # HSTS is conditioned on HTTPS deliberately. Sending it over http is meaningless, and
    # sending it from a local development environment pins the browser to https for the whole
    # of localhost — breaking every other project on the same machine, and hard to undo.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

    # Hide PHP's version from the headers.
    Header always unset X-Powered-By

    # ── CSP: fully enforced ───────────────────────────────────
    #
    # **With no 'unsafe-inline' in script-src.** This was not possible before: the views
    # carried fourteen embedded <script> blocks and thirty-three onclick/onchange handlers —
    # all of them execution blocks that any serious policy blocks.
    #
    # What changed to make it possible:
    #   · the data → <script type="application/json"> islands (pageData), which are not
    #     execution blocks, so script-src does not concern them at all.
    #   · the handlers → data-action and data-* attributes, delegated by a single listener
    #     in js/core/inline-actions.js.
    #   · the theme boot script → allowed **by its digest alone**. It cannot be moved into a
    #     file: it has to run before paint, or the user sees a flash of the wrong theme.
    #
    # ⚠️ The digest is tied to themeBootScript()'s content letter for letter. Any edit to it
    # — even a space — invalidates the digest, so the script stops and the theme flashes.
    # Recompute it on any change:
    #     php -r "require 'app/helpers/assets_helper.php';
    #             preg_match('#<script>(.*?)</script>#s', themeBootScript(), \$m);
    #             echo 'sha256-'.base64_encode(hash('sha256', \$m[1], true));"
    #
    # ⚠️ And that warning was not enough, for a reason deeper than an oversight: the digest
    # is computed over the content **including the line endings**, and .gitattributes checks
    # this file out as CRLF on Windows and LF elsewhere. So one source produced two digests,
    # both measured:
    #
    #     CRLF (Windows/XAMPP)  sha256-6TLKQaFcqhxCDjTk0QjqyBctIHNhyj10R3cAU65yIvQ=
    #     LF   (Linux/Docker)   sha256-n33GJ973YEUTpbG1xOj611JYTc5wI4V+8xmEtfPaLjk=
    #
    # Whichever is written here, the script stays **blocked on the other platform** — with no
    # visible fault beyond a white flash and one refusal line in the console. Which means
    # fixing the digest locally on Windows was breaking it on the deployment server.
    #
    # The cure belongs at the source rather than here: themeBootScript() normalises the line
    # endings to LF before the text leaves the function, so the digest is the same
    # everywhere and the value below is correct on both platforms. It is the same thing
    # Migrator::checksum does, for the same reason.
    #
    # And the guard is a test rather than a comment:
    # tests/Unit/SecurityHeadersTest.php computes the digest from the function itself and
    # compares it with this line, failing the build at the first divergence.
    #
    # img-src without the open `https:`.
    #
    # It was open for one reason: the two-factor QR image was fetched from api.qrserver.com
    # — through a URL carrying **the secret itself** in the query string. The image is now
    # generated locally (bacon/bacon-qr-code) and delivered as a data: URI, so nothing
    # remains to justify allowing any image host on the internet.
    #
    # Verified before tightening: no external image in any view, and none in the data
    # (products · variants · slider slides — zero paths beginning with http).
    # `data:` stays: it is what carries the QR now.
    #
    # **And with no 'unsafe-inline' in style-src either** — the last step that had been
    # deferred. The views carried 234 `style="…"` attributes, and a policy that permits
    # inline styles cannot prevent an injected one.
    #
    # What changed to make it possible:
    #   · 217 static attributes → utilities in base/utilities.css (and Bootstrap where it
    #     had an exact equivalent: d-none · text-nowrap · align-middle).
    #   · the conditional attributes → conditional classes:
    #     `class="<?= $x ? 'd-none' : '' ?>"` instead of
    #     `style="<?= $x ? 'display:none;' : '' ?>"`.
    #   · the admin dashboard tiles → named tones (u-tone-*): the palette is closed and
    #     defined in the view itself, so the array now carries 'tone' => 'amber' instead of
    #     'color' => '#f59e0b'.
    #   · the variant colour alone is an **open** set (it comes from the database) — it is
    #     emitted in data-swatch, and js/store/variant-swatches.js writes it into a custom
    #     CSS property through the CSSOM. And a CSP governs what is in the markup, not what
    #     an allowed script writes.
    #
    # ⚠️ Do not return any `style="…"` to a view. The tests/Unit/InlineStyleTest.php test
    # refuses that at build time rather than at deployment time.
    #
    # ⚠️ `code.jquery.com` was dropped from script-src. It was allowed because every page
    # loaded jQuery — and the tag was removed once it was established that it is **not used
    # at all**: zero `$(` and zero `jQuery` across public/js and app/views.
    #
    # And dropping it is not cosmetic tidying: every host on this list is an origin that can
    # execute JavaScript on every page of the store and the control panel, the checkout page
    # included. A host that serves nothing should not hold that.
    #
    # And the hosts that remain are now constrained by integrity on the tags themselves —
    # see app/views/inc/footer.php. So allowing a host no longer means trusting any file it
    # sends.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-n33GJ973YEUTpbG1xOj611JYTc5wI4V+8xmEtfPaLjk=' https://cdn.jsdelivr.net https://js.hcaptcha.com https://*.hcaptcha.com; style-src 'self' https://cdn.jsdelivr.net https://*.hcaptcha.com; img-src 'self' data:; font-src 'self' data: https://cdn.jsdelivr.net; connect-src 'self' https://*.hcaptcha.com; frame-src https://*.hcaptcha.com; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"


</IfModule>
