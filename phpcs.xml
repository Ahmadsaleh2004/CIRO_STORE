<?xml version="1.0"?>
<ruleset name="Cairo Store">
    <description>PSR-12 — the standard any PHP developer opening the project assumes.</description>

    <file>app</file>
    <file>scripts</file>
    <file>tests</file>

    <exclude-pattern>app/views/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>

    <arg name="colors"/>
    <arg value="p"/>
    <arg name="extensions" value="php"/>

    <rule ref="PSR12">
        <!-- The limit is excluded, not tightened. 153 lines in app/, scripts/ and
             tests/ pass 120 characters, and almost all of them are single
             `new OA\Property(property: …, type: …, description: …)` arguments inside an
             OpenAPI attribute block. Splitting those across lines makes the
             specification harder to read, not easier, so the rule would be reporting a
             deliberate shape rather than a fault. -->
        <exclude name="Generic.Files.LineLength"/>

        <!-- The line endings belong to .gitattributes, not to this file.
             `* text=auto` stores LF in git and checks CRLF out on Windows, so this check
             cannot possibly pass on both systems: it passes in CI (Linux, LF) and fails on
             the development machine (CRLF) for the same file with the same content. A check
             whose result follows the operating system rather than the code is not a
             check. -->
        <exclude name="Generic.Files.LineEndings"/>
    </rule>

    <!-- Bootstrap files declare symbols and perform side effects together, by the nature
         of their job: config.php defines constants and configures the session, and
         tests/bootstrap.php defines functions and builds the test database. That is the
         definition of a bootstrap file, not a violation in it. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>app/config/*</exclude-pattern>
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <exclude-pattern>tests/phpstan-bootstrap.php</exclude-pattern>
        <exclude-pattern>scripts/*</exclude-pattern>
        <exclude-pattern>public/index.php</exclude-pattern>
    </rule>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
